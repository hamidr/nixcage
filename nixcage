#!/usr/bin/env bash
# nixcage -- per-project NixOS containers for AI coding agents

set -euo pipefail

NIXCAGE_VERSION="4.0.0"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

log_info() { echo -e "${CYAN}[nixcage]${NC} $*"; }
log_ok()   { echo -e "${GREEN}[nixcage]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[nixcage]${NC} $*"; }
log_err()  { echo -e "${RED}[nixcage]${NC} $*" >&2; }

require_cmd() {
  local cmd="$1"
  local hint="${2:-}"
  if ! command -v "$cmd" &>/dev/null; then
    log_err "'$cmd' is required but not found."
    [[ -n "$hint" ]] && log_err "  $hint"
    exit 1
  fi
}

detect_os() {
  case "$(uname -s)" in
  Linux*)  echo "linux" ;;
  Darwin*) echo "macos" ;;
  *)
    log_err "Unsupported OS: $(uname -s)"
    exit 1
    ;;
  esac
}

# NIXCAGE_OS is a test override; real installs branch on the actual OS.
OS="${NIXCAGE_OS:-$(detect_os)}"

# The config flake is user-owned; the CLI never writes into it. It is the
# macOS configuration source; on Linux the host's nixosModules.host renders
# /etc/nixcage/config instead and there is no VM.
NIXCAGE_FLAKE="${NIXCAGE_FLAKE:-$HOME/.config/nixcage}"
HOST_CONFIG="${NIXCAGE_HOST_CONFIG:-/etc/nixcage/config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nixcage"

# All values the CLI needs from the config flake, cached at build time so
# 'enter' does not pay a nix eval on every invocation.
CACHE_FILE="$STATE_DIR/cache"

# Pick the VM configuration like nixos-rebuild picks a host: prefer
# nixosConfigurations."nixcage-<hostname>" so one flake can serve several
# machines, fall back to nixosConfigurations.nixcage.
resolve_vm_attr() {
  local host
  host="$(hostname -s)"
  if nix eval "$NIXCAGE_FLAKE#nixosConfigurations" \
       --apply "c: c ? \"nixcage-$host\"" 2>/dev/null | grep -qx true; then
    echo "nixosConfigurations.\"nixcage-$host\".config"
  else
    echo "nixosConfigurations.nixcage.config"
  fi
}

check_flake() {
  # A path flake must contain flake.nix; other refs (git urls) are taken
  # as-is and nix reports their errors.
  if [[ "$NIXCAGE_FLAKE" == /* && ! -f "$NIXCAGE_FLAKE/flake.nix" ]]; then
    log_err "No config flake at $NIXCAGE_FLAKE"
    log_err "Create one with: nix flake new -t github:hamidr/nixcage ~/.config/nixcage"
    log_err "Or point --flake / NIXCAGE_FLAKE at an existing one."
    exit 1
  fi
}

# Load configuration into VM_* globals from the platform's source: the
# host-rendered /etc/nixcage/config on Linux, the build-time cache on macOS.
cfg_read() {
  if [[ "$OS" == "linux" ]]; then
    host_read_config
  else
    vm_read_cache
  fi
}

# Read the config rendered by nixosModules.host on a Linux host.
host_read_config() {
  if [[ ! -f "$HOST_CONFIG" ]]; then
    log_err "No host config at $HOST_CONFIG."
    log_err "Import nixcage's nixosModules.host in your NixOS configuration and rebuild."
    exit 1
  fi
  VM_WORKSPACE_ROOTS=""
  local key val
  while IFS='=' read -r key val || [[ -n "$key" ]]; do
    case "$key" in
    WORKSPACE_ROOTS) VM_WORKSPACE_ROOTS="$val" ;;
    esac
  done <"$HOST_CONFIG"
}

# Read the build-time cache (SSH_PORT, WORKSPACE_ROOTS) into globals.
vm_read_cache() {
  if [[ ! -f "$CACHE_FILE" ]]; then
    log_err "VM has not been built yet. Run 'nixcage rebuild' first."
    exit 1
  fi
  VM_SSH_PORT=""
  VM_WORKSPACE_ROOTS=""
  local key val
  while IFS='=' read -r key val || [[ -n "$key" ]]; do
    case "$key" in
    SSH_PORT)        VM_SSH_PORT="$val" ;;
    WORKSPACE_ROOTS) VM_WORKSPACE_ROOTS="$val" ;;
    esac
  done <"$CACHE_FILE"
}

vm_pid_file() { echo "$STATE_DIR/vm.pid"; }
vm_virtiofsd_pid_file() { echo "$STATE_DIR/virtiofsd.pid"; }

# How long to wait for the guest to shut itself down before signalling qemu,
# and then for qemu to exit before killing it. Overridable because the test
# suite drives them with stubs and must not sit out the real waits.
VM_SHUTDOWN_TIMEOUT="${NIXCAGE_SHUTDOWN_TIMEOUT:-30}"
VM_KILL_TIMEOUT="${NIXCAGE_KILL_TIMEOUT:-10}"

# Wait up to $2 seconds for process $1 to disappear. Answers whether it did.
vm_wait_for_exit() {
  local pid="$1" deadline=$((SECONDS + $2))
  while [[ $SECONDS -lt $deadline ]]; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 1
  done
  ! kill -0 "$pid" 2>/dev/null
}

# The pid must both be alive and still look like the VM runner: after a
# host reboot the state file survives and the pid can be reused by an
# unrelated process, which 'down' would otherwise kill.
vm_is_running() {
  local pid_file
  pid_file="$(vm_pid_file)"
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || return 1
  if ! ps -p "$pid" -o args= 2>/dev/null | grep -qE 'microvm|qemu'; then
    rm -f "$pid_file"
    return 1
  fi
}

# True when something already listens on the given local TCP port.
port_in_use() {
  local port="$1"
  (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || return 1
  exec 3>&- 3<&-
}

# Container names are passed to root-level rm -rf and into SSH command
# strings; reject anything beyond the derived-name alphabet.
validate_container_name() {
  [[ "$1" =~ ^[a-zA-Z0-9-]+$ ]]
}

# Generate the host keypair lazily on first use; the public key must be
# listed in nixcage.authorizedKeys in the config flake.
ensure_ssh_key() {
  local key="$STATE_DIR/id_ed25519"
  [[ -f "$key" ]] && return 0
  require_cmd "ssh-keygen"
  mkdir -p "$STATE_DIR"
  ssh-keygen -t ed25519 -f "$key" -N "" -C "nixcage@$(hostname)" -q
  log_ok "Generated SSH keypair at $key"
  log_warn "Add this public key to nixcage.authorizedKeys in your config flake:"
  echo
  cat "$key.pub"
  echo
}

vm_ssh() {
  vm_read_cache
  ssh -p "$VM_SSH_PORT" -i "$STATE_DIR/id_ed25519" \
    -o "UserKnownHostsFile=$STATE_DIR/known_hosts" \
    -o "StrictHostKeyChecking=yes" \
    -o "ConnectTimeout=5" \
    -o "BatchMode=yes" \
    "nixcage@127.0.0.1" "$@"
}

# Poll until SSH is reachable or the VM process dies.
# The VM's host key persists on its data volume, so accept-new trusts it
# once on first contact and every later boot is verified against it.
vm_wait_for_ssh() {
  vm_read_cache
  local known_hosts="$STATE_DIR/known_hosts"
  local key="$STATE_DIR/id_ed25519"
  local timeout=120
  [[ "$OS" == "macos" ]] && timeout=300
  local deadline=$((SECONDS + timeout))
  log_info "Waiting for VM SSH..."
  while [[ $SECONDS -lt $deadline ]]; do
    if ssh -p "$VM_SSH_PORT" -i "$key" \
         -o "UserKnownHostsFile=$known_hosts" \
         -o "StrictHostKeyChecking=accept-new" \
         -o "ConnectTimeout=5" \
         -o "BatchMode=yes" \
         "nixcage@127.0.0.1" true 2>/dev/null; then
      return 0
    fi
    if ! vm_is_running; then
      log_err "VM process died before SSH became reachable."
      log_err "Check $STATE_DIR/vm.log for details."
      exit 1
    fi
    sleep 2
  done
  log_err "Timed out waiting for VM SSH (${timeout}s)."
  exit 1
}

# Launch the virtiofsd processes backing the VM's virtiofs shares.
#
# microvm.nix generates result/bin/virtiofsd-run as a supervisord wrapper
# whose config sets `user=root`, so it refuses to start as a normal user.
# We bypass supervisord and exec each `command=` from the [program:...]
# sections directly, recording PIDs for cleanup.
#
# virtiofsd and qemu use a *relative* socket path, so both must share a
# CWD. Callers must cd to $STATE_DIR before invoking this and before
# launching the VM.
vm_start_virtiofsd() {
  local result="$1"
  local wrapper="$result/bin/virtiofsd-run"

  [[ -x "$wrapper" ]] || return 0

  local conf
  conf="$(grep -oE -- '--configuration[[:space:]]+\S+' "$wrapper" | awk '{print $2}')"
  if [[ -z "$conf" || ! -r "$conf" ]]; then
    log_err "virtiofsd-run wrapper references unreadable supervisord config: $conf"
    exit 1
  fi

  local pid_file
  pid_file="$(vm_virtiofsd_pid_file)"
  : >"$pid_file"
  local log_file="$STATE_DIR/virtiofsd.log"

  # Extract command= lines from [program:...] sections only.
  local in_program=0 line cmd
  while IFS= read -r line; do
    if [[ "$line" =~ ^\[program: ]]; then
      in_program=1
      continue
    elif [[ "$line" =~ ^\[ ]]; then
      in_program=0
      continue
    fi
    if [[ "$in_program" -eq 1 && "$line" =~ ^command= ]]; then
      cmd="${line#command=}"
      # microvm.nix hardcodes --socket-group=kvm; chgrp fails when the
      # invoking user isn't in the kvm group. Strip it so virtiofsd starts.
      bash <(sed 's/--socket-group=[^[:space:]]*//g' "$cmd") \
        >>"$log_file" 2>&1 &
      echo "$!" >>"$pid_file"
    fi
  done <"$conf"
}

vm_stop_virtiofsd() {
  local pid_file
  pid_file="$(vm_virtiofsd_pid_file)"
  [[ -f "$pid_file" ]] || return 0
  local pid
  while read -r pid; do
    [[ -n "$pid" ]] || continue
    kill "$pid" 2>/dev/null || true
  done <"$pid_file"
  rm -f "$pid_file"
  rm -f "$STATE_DIR"/nixcage-virtiofs-*.sock "$STATE_DIR"/*-virtiofs-*.sock
}

vm_build() {
  require_cmd "nix"
  check_flake
  mkdir -p "$STATE_DIR"

  local attr
  attr="$(resolve_vm_attr)"
  log_info "Building VM from $NIXCAGE_FLAKE#${attr%.config} (first build takes a while)..."
  nix build "$NIXCAGE_FLAKE#$attr.microvm.declaredRunner" \
    --out-link "$STATE_DIR/result" -L

  # Cache the config values the CLI needs at runtime so 'enter' stays free
  # of nix eval calls. The cache is regenerated on every rebuild.
  local port roots
  port="$(nix eval --raw "$NIXCAGE_FLAKE#$attr.nixcage.sshPort" --apply toString)"
  roots="$(nix eval --json "$NIXCAGE_FLAKE#$attr.nixcage.workspaceRoots" | jq -r 'join(":")')"
  cat >"$CACHE_FILE" <<EOF
SSH_PORT=$port
WORKSPACE_ROOTS=$roots
EOF

  # A rebuild may legitimately change the VM's persistent host key; a
  # stale entry would otherwise hard-fail every later connection.
  rm -f "$STATE_DIR/known_hosts"

  log_ok "VM built."
}

vm_start() {
  ensure_ssh_key

  local result="$STATE_DIR/result"
  if [[ ! -e "$result" ]]; then
    vm_build
  fi

  # A foreign listener on the SSH port would break qemu's forward -- or
  # worse, get trusted by the accept-new handshake meant for the VM.
  vm_read_cache
  if port_in_use "$VM_SSH_PORT"; then
    log_err "Port $VM_SSH_PORT is already in use on 127.0.0.1."
    log_err "Free it, or change nixcage.sshPort and run 'nixcage rebuild'."
    exit 1
  fi

  # Clear stale virtiofsd processes/sockets from a previous failed start.
  vm_stop_virtiofsd

  local runner
  if [[ -x "$result/bin/microvm-run" ]]; then
    runner="$(readlink -f "$result/bin/microvm-run")"
  else
    runner="$(readlink -f "$result")"
  fi
  if [[ ! -x "$runner" ]]; then
    log_err "VM runner is not executable: $runner"
    exit 1
  fi

  local log_file="$STATE_DIR/vm.log"
  local pid_file
  pid_file="$(vm_pid_file)"

  log_info "Starting VM..."
  (
    cd "$STATE_DIR"
    vm_start_virtiofsd "$result"
    "$runner" >"$log_file" 2>&1 &
    echo "$!" >"$pid_file"
  )

  # vm_wait_for_ssh exits on failure, which would orphan the hypervisor
  # (still holding the SSH port and blocking every later start) and
  # virtiofsd. An EXIT trap cleans both up only when ssh did not succeed.
  _nixcage_start_ok=0
  trap '[[ $_nixcage_start_ok -eq 1 ]] || { kill "$(cat "$(vm_pid_file)" 2>/dev/null)" 2>/dev/null; rm -f "$(vm_pid_file)"; vm_stop_virtiofsd; }' EXIT
  vm_wait_for_ssh
  _nixcage_start_ok=1
  trap - EXIT

  log_ok "VM ready."
}

ensure_vm() {
  vm_is_running || vm_start
}

# Derive a stable container name from the project path: sanitized basename
# plus a short hash so distinct paths with equal basenames never collide.
container_name_for() {
  local project_dir="$1"
  local base hash
  base="$(basename "$project_dir" | tr -cs 'a-zA-Z0-9' '-')"
  base="${base#-}"
  base="${base%-}"
  hash="$(printf '%s' "$project_dir" | sha256sum | awk '{print substr($1, 1, 8)}')"
  echo "${base:-project}-${hash}"
}

# Verify the path sits under a configured workspace root; on macOS the
# roots are mounted at identical paths inside the VM, so the same path is
# valid on both sides. On Linux the containers run on the host directly.
check_workspace_root() {
  local project_dir="$1"
  cfg_read
  local root
  IFS=':' read -ra _roots <<<"$VM_WORKSPACE_ROOTS"
  for root in "${_roots[@]}"; do
    [[ -n "$root" ]] || continue
    if [[ "$project_dir" == "$root" || "$project_dir" == "$root"/* ]]; then
      return 0
    fi
  done
  log_err "$project_dir is not under any workspace root ($VM_WORKSPACE_ROOTS)."
  log_err "Add the root to nixcage.workspaceRoots and apply your configuration."
  exit 1
}

cmd_enter() {
  local project_dir="$PWD"

  if [[ ! -f "$project_dir/flake.nix" ]]; then
    log_err "No flake.nix in $project_dir -- a nixcage project is any flake directory."
    exit 1
  fi

  check_workspace_root "$project_dir"

  local name
  name="$(container_name_for "$project_dir")"

  # Accept both 'enter -- cmd...' and 'enter cmd...'.
  [[ "${1:-}" == "--" ]] && shift

  # A session signs its commits through the invoking user's ssh-agent, so
  # the socket is forwarded rather than any key material being copied in.
  # Without a reachable agent the session still enters and only signing
  # fails, which is the same outcome as running git with no key.
  local -a agent_fwd=()
  if [[ -n "${SSH_AUTH_SOCK:-}" && -e "${SSH_AUTH_SOCK}" ]]; then
    agent_fwd=(--auth-sock "$SSH_AUTH_SOCK")
  fi

  if [[ "$OS" == "linux" ]]; then
    [[ $# -eq 0 ]] && log_info "Entering container $name..."
    sudo nixcage-container enter "${agent_fwd[@]}" "$name" "$project_dir" "$@"
    return
  fi

  ensure_vm

  # Everything in the remote command is re-split by the remote shell, so
  # every word gets %q, not just the trailing command arguments.
  local remote=(sudo nixcage-container enter)
  # The forwarded socket lives in the VM and is named by the remote shell,
  # so the expansion is deliberately left for it to perform.
  local -a ssh_fwd=()
  if [[ ${#agent_fwd[@]} -gt 0 ]]; then
    ssh_fwd=(-A)
    # shellcheck disable=SC2016  # the remote shell performs this expansion
    remote+=(--auth-sock '"$SSH_AUTH_SOCK"')
  fi
  remote+=("$(printf '%q' "$name")" "$(printf '%q' "$project_dir")")
  local arg
  for arg in "$@"; do
    remote+=("$(printf '%q' "$arg")")
  done

  if [[ $# -eq 0 ]]; then
    log_info "Entering container $name..."
    vm_ssh "${ssh_fwd[@]}" -t -- "${remote[@]}"
  else
    vm_ssh "${ssh_fwd[@]}" -- "${remote[@]}"
  fi
}

## Run a command as root wherever this machine's cages are: here on Linux,
## and inside the shared VM on macOS. Exported because everything nixcage
## builds a session for lives on that side of the transport, and a dependant
## that had to reach it itself would need this machine's SSH key, its port and
## the layout of nixcage's own state.
##
## It is not a shell. Every word arrives as one argument, and on macOS every
## word is quoted for the remote shell, which re-splits the whole line rather
## than only the trailing arguments.
cmd_exec() {
  local tty="" agent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --tty) tty=1; shift ;;
    --agent) agent=1; shift ;;
    --) shift; break ;;
    *) break ;;
    esac
  done

  if [[ $# -eq 0 ]]; then
    log_err "usage: nixcage exec [--tty] [--agent] -- <command> [args...]"
    exit 1
  fi

  # sudo clears the environment, so the forwarded socket has to be carried
  # across it by name. The command reads SSH_AUTH_SOCK from its own
  # environment rather than being handed a path: on macOS the path is the
  # VM's, which nothing on this side can spell.
  local -a sudo_opts=()
  [[ -n "$agent" ]] && sudo_opts=(--preserve-env=SSH_AUTH_SOCK)

  if [[ "$OS" == "linux" ]]; then
    sudo "${sudo_opts[@]}" "$@"
    return
  fi

  ensure_vm

  local remote=(sudo "${sudo_opts[@]}") arg
  local -a ssh_opts=()
  [[ -n "$agent" ]] && ssh_opts+=(-A)
  [[ -n "$tty" ]] && ssh_opts+=(-t)
  for arg in "$@"; do
    remote+=("$(printf '%q' "$arg")")
  done
  vm_ssh "${ssh_opts[@]}" -- "${remote[@]}"
}
require_vm_platform() {
  if [[ "$OS" == "linux" ]]; then
    log_err "No VM on Linux -- containers run on the host."
    log_err "Apply configuration changes with nixos-rebuild instead."
    exit 1
  fi
}

cmd_down() {
  require_vm_platform
  if ! vm_is_running; then
    log_warn "VM is not running."
    vm_stop_virtiofsd
    return 0
  fi

  local pid
  pid="$(cat "$(vm_pid_file)")"

  log_info "Shutting the VM down (pid $pid)..."

  # Ask the guest to power itself off, so its filesystems are unmounted and
  # everything written is on disk before qemu goes. Killing qemu instead
  # leaves the last seconds of writes in the guest's page cache, which on ext4
  # cost whole worktrees and still costs those seconds on ZFS.
  #
  # The connection dies with the guest, so ssh reports failure whether the
  # shutdown worked or not. Only the process disappearing answers that.
  if [[ -f "$CACHE_FILE" ]]; then
    vm_ssh -- sudo poweroff >/dev/null 2>&1 || true
  fi

  if ! vm_wait_for_exit "$pid" "$VM_SHUTDOWN_TIMEOUT"; then
    log_warn "The VM did not shut down; stopping qemu."
    kill "$pid" 2>/dev/null || true
    if ! vm_wait_for_exit "$pid" "$VM_KILL_TIMEOUT"; then
      log_warn "VM did not stop gracefully; forcing kill."
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi

  rm -f "$(vm_pid_file)"
  vm_stop_virtiofsd
  log_ok "VM stopped."
}

cmd_rebuild() {
  require_vm_platform
  vm_build
  if vm_is_running; then
    log_warn "Restarting VM -- all container sessions will be interrupted."
    cmd_down
    vm_start
  fi
}

cmd_rm() {
  local name
  if [[ $# -gt 0 ]]; then
    name="$1"
    if ! validate_container_name "$name"; then
      log_err "Invalid container name: $name"
      exit 1
    fi
  else
    if [[ ! -f "$PWD/flake.nix" ]]; then
      log_err "Usage: nixcage rm [name]  (run without a name from inside a project)"
      exit 1
    fi
    name="$(container_name_for "$PWD")"
  fi

  # Confirm before ensure_vm: aborting must not boot a VM.
  log_warn "This deletes container '$name' and its persistent home."
  read -rp "Continue? [y/N] " answer
  if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
    log_info "Aborted."
    return 0
  fi

  if [[ "$OS" == "linux" ]]; then
    sudo nixcage-container rm "$name"
  else
    ensure_vm
    vm_ssh -- sudo nixcage-container rm "$name"
  fi
  log_ok "Removed container $name."
}

cmd_status() {
  echo "${BOLD}nixcage status${NC}"

  if [[ "$OS" == "linux" ]]; then
    host_read_config
    echo "  Host config:  $HOST_CONFIG"
    echo "  Roots:        $VM_WORKSPACE_ROOTS"
    echo "  Containers:"
    sudo nixcage-container list 2>/dev/null | sed 's/^/    /' || true
    return
  fi

  echo "  Config flake: $NIXCAGE_FLAKE"

  local built="no"
  [[ -e "$STATE_DIR/result" ]] && built="yes"
  echo "  Built:        $built"

  local running="no" pid=""
  if vm_is_running; then
    running="yes"
    pid="$(cat "$(vm_pid_file)")"
  fi
  echo "  Running:      $running${pid:+ (pid $pid)}"

  if [[ -f "$CACHE_FILE" ]]; then
    vm_read_cache
    echo "  SSH port:     $VM_SSH_PORT"
    echo "  Roots:        $VM_WORKSPACE_ROOTS"
  fi

  if [[ "$running" == "yes" ]]; then
    local ssh_reachable="no"
    vm_ssh true 2>/dev/null && ssh_reachable="yes" || true
    echo "  SSH:          $ssh_reachable"
    if [[ "$ssh_reachable" == "yes" ]]; then
      echo "  Containers:"
      vm_ssh -- sudo nixcage-container list 2>/dev/null | sed 's/^/    /' || true
      local age_pub
      age_pub="$(vm_ssh -- sudo age-keygen -y /var/lib/nixcage/age.key 2>/dev/null || true)"
      if [[ -n "$age_pub" ]]; then
        echo "  Age key:      $age_pub"
      fi
    fi
  fi
}

cmd_help() {
  cat <<HELP
${BOLD}nixcage${NC} v${NIXCAGE_VERSION} -- per-project NixOS containers for AI coding agents

${BOLD}Usage:${NC}
  nixcage [--flake <ref>] <command> [args...]

${BOLD}Commands:${NC}
  enter [-- cmd...]  Enter this project's container (macOS: starts the VM if needed)
  exec [--tty] [--agent] -- <cmd...>
                     Run a command as root where the cages are: here on Linux,
                     inside the VM on macOS. This is how a tool built on
                     nixcage reaches nixcage-container.
  rm [name]          Delete a project container and its persistent home
  status             Show container state (macOS: VM state and age public key)
  down               macOS only: stop the VM
  rebuild            macOS only: rebuild the VM from the config flake and restart it
  version            Print version
  help               Show this help

${BOLD}Configuration:${NC}
  Linux: containers run on this host. Import nixcage's nixosModules.host in
  your NixOS configuration and set nixcage.workspaceRoots; apply with
  nixos-rebuild.

  macOS: containers run in a shared VM configured by a flake you own
  (default: ~/.config/nixcage, override with --flake or NIXCAGE_FLAKE):

    nix flake new -t github:hamidr/nixcage ~/.config/nixcage

  A project is any flake directory under one of your nixcage.workspaceRoots.
  No nixcage files exist in projects.
HELP
}

main() {
  if [[ "${1:-}" == "--flake" ]]; then
    if [[ -z "${2:-}" ]]; then
      log_err "--flake requires an argument"
      exit 1
    fi
    NIXCAGE_FLAKE="$2"
    shift 2
  fi

  local command="${1:-help}"
  shift || true
  case "$command" in
  enter)   cmd_enter "$@" ;;
  exec)    cmd_exec "$@" ;;
  down)    cmd_down "$@" ;;
  rebuild) cmd_rebuild "$@" ;;
  rm)      cmd_rm "$@" ;;
  status)  cmd_status "$@" ;;
  version | --version | -v) echo "nixcage $NIXCAGE_VERSION" ;;
  help | --help | -h) cmd_help ;;
  *)
    log_err "Unknown command: $command"
    cmd_help
    exit 1
    ;;
  esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
