#!/usr/bin/env bash
# nixcage -- NixOS microVM environments for AI coding agents

set -euo pipefail

NIXCAGE_VERSION="1.0.0"
NIXCAGE_VM_DIR=".nixcage-vm"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

log_info() { echo -e "${CYAN}[nixcage]${NC} $*"; }
log_ok()   { echo -e "${GREEN}[nixcage]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[nixcage]${NC} $*"; }
log_err()  { echo -e "${RED}[nixcage]${NC} $*" >&2; }

require_cmd() {
  local cmd="$1"
  local hint="${2:-}"
  if ! command -v "$cmd" &>/dev/null; then
    log_err "'$cmd' is required but not found."
    [[ -n "$hint" ]] && log_err "  $hint"
    exit 1
  fi
}

detect_os() {
  case "$(uname -s)" in
  Linux*)  echo "linux" ;;
  Darwin*) echo "macos" ;;
  *)
    log_err "Unsupported OS: $(uname -s)"
    exit 1
    ;;
  esac
}

OS="$(detect_os)"

# Walk up from $PWD looking for nixcage.vm.nix; echo the directory that owns it.
# Exits with an error when not found so callers can rely on the return value.
find_vm_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/nixcage.vm.nix" ]]; then
      echo "$dir"
      return
    fi
    dir="$(dirname "$dir")"
  done
  log_err "No nixcage.vm.nix found (searched up from $PWD)"
  log_err "Run 'nixcage init' to create one."
  exit 1
}

# Read .nixcage-vm/config (key=value, # comments) into VM_* variables.
vm_read_config() {
  local project_dir="$1"
  local config_file="$project_dir/$NIXCAGE_VM_DIR/config"
  if [[ ! -f "$config_file" ]]; then
    log_err "VM config not found: $config_file"
    log_err "Run 'nixcage init' to regenerate."
    exit 1
  fi
  VM_SSH_PORT=""
  VM_SECRET_VARS=""
  VM_HYPERVISOR=""
  VM_SHARE_PROTO=""
  VM_NIX_SYSTEM=""
  while IFS='=' read -r key val || [[ -n "$key" ]]; do
    # strip inline comments and leading/trailing whitespace
    val="${val%%#*}"
    val="${val#"${val%%[! ]*}"}"
    val="${val%"${val##*[! ]}"}"
    key="${key#"${key%%[! ]*}"}"
    case "$key" in
    SSH_PORT)    VM_SSH_PORT="$val" ;;
    SECRET_VARS) VM_SECRET_VARS="$val" ;;
    HYPERVISOR)  VM_HYPERVISOR="$val" ;;
    SHARE_PROTO) VM_SHARE_PROTO="$val" ;;
    NIX_SYSTEM)  VM_NIX_SYSTEM="$val" ;;
    esac
  done < <(grep -v '^\s*#' "$config_file" || true)
}

vm_pid_file() {
  echo "$1/$NIXCAGE_VM_DIR/vm.pid"
}

# Returns 0 if the VM process recorded in the pid file is alive.
vm_is_running() {
  local project_dir="$1"
  local pid_file
  pid_file="$(vm_pid_file "$project_dir")"
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# Find a free TCP port. Tries python3 first, falls back to perl.
vm_free_port() {
  if command -v python3 &>/dev/null; then
    python3 -c "
import socket
s = socket.socket()
s.bind(('', 0))
print(s.getsockname()[1])
s.close()
"
  elif command -v perl &>/dev/null; then
    perl -e '
use Socket;
socket(S, PF_INET, SOCK_STREAM, getprotobyname("tcp"));
bind(S, sockaddr_in(0, INADDR_ANY));
my $port = (sockaddr_in(getsockname(S)))[0];
close(S);
print "$port\n";
'
  else
    log_err "python3 or perl is required to find a free port"
    exit 1
  fi
}

# Scan host environment for known AI-tool keys; echo space-separated list of
# those that are currently set.
vm_detect_ai_keys() {
  local found=()
  local var
  for var in ANTHROPIC_API_KEY OPENAI_API_KEY OPENCODE_API_KEY GITHUB_TOKEN; do
    [[ -n "${!var:-}" ]] && found+=("$var")
  done
  echo "${found[*]:-}"
}

# Map uname -m to a NixOS system string.
detect_nix_system() {
  case "$(uname -m)" in
  x86_64)          echo "x86_64-linux" ;;
  arm64 | aarch64) echo "aarch64-linux" ;;
  *)
    log_err "Unsupported machine architecture: $(uname -m)"
    exit 1
    ;;
  esac
}

# Wrap ssh so every call uses the project-local key and known_hosts file.
vm_ssh() {
  local project_dir="$1"; shift
  local known_hosts="$project_dir/$NIXCAGE_VM_DIR/known_hosts"
  local key="$project_dir/$NIXCAGE_VM_DIR/id_ed25519"
  vm_read_config "$project_dir"
  ssh -p "$VM_SSH_PORT" -i "$key" \
    -o "UserKnownHostsFile=$known_hosts" \
    -o "StrictHostKeyChecking=yes" \
    -o "ConnectTimeout=5" \
    -o "BatchMode=yes" \
    "nixcage@127.0.0.1" "$@"
}

# Poll until SSH is reachable or the VM process dies.
vm_wait_for_ssh() {
  local project_dir="$1"
  local deadline=$((SECONDS + 60))
  log_info "Waiting for VM SSH..."
  while [[ $SECONDS -lt $deadline ]]; do
    if vm_ssh "$project_dir" true 2>/dev/null; then
      return 0
    fi
    if ! vm_is_running "$project_dir"; then
      log_err "VM process died before SSH became reachable."
      log_err "Check $project_dir/$NIXCAGE_VM_DIR/vm.log for details."
      exit 1
    fi
    sleep 2
  done
  log_err "Timed out waiting for VM SSH (60s)."
  exit 1
}

# Populate the known_hosts file from the live VM.
vm_bootstrap_known_hosts() {
  local project_dir="$1"
  vm_read_config "$project_dir"
  local known_hosts="$project_dir/$NIXCAGE_VM_DIR/known_hosts"
  ssh-keyscan -p "$VM_SSH_PORT" -H 127.0.0.1 >"$known_hosts" 2>/dev/null
  chmod 600 "$known_hosts"
}

# Push API-key exports into the running VM via SSH pipe so they land in
# /run (tmpfs) and are never flushed to disk.
vm_inject_secrets() {
  local project_dir="$1"
  vm_read_config "$project_dir"
  [[ -z "$VM_SECRET_VARS" ]] && return 0
  local secrets=""
  local var
  # VM_SECRET_VARS is comma-separated
  IFS=',' read -ra _vars <<< "$VM_SECRET_VARS"
  for var in "${_vars[@]}"; do
    var="${var#"${var%%[! ]*}"}"  # trim leading space
    [[ -n "${!var:-}" ]] && secrets+="export ${var}='${!var//\'/\'\\\'\'}'
"
  done
  unset _vars
  [[ -z "$secrets" ]] && return 0
  printf '%s' "$secrets" | vm_ssh "$project_dir" \
    "sudo tee /run/nixcage-secrets >/dev/null && sudo chmod 600 /run/nixcage-secrets && sudo systemctl restart nixcage-secrets"
  log_info "Secrets injected."
}

# Compute a hash that covers the user's VM config and the locked inputs.
# Written to .nixcage-vm/build-hash after every successful build.
vm_compute_build_hash() {
  local project_dir="$1"
  sha256sum \
    "$project_dir/nixcage.vm.nix" \
    "$project_dir/$NIXCAGE_VM_DIR/flake.lock" \
    2>/dev/null | sha256sum | awk '{print $1}'
}

cmd_init() {
  require_cmd "nix"
  require_cmd "ssh-keygen"
  require_cmd "ssh-keyscan"

  local dir="${1:-.}"
  local project_dir
  project_dir="$(cd "$dir" && pwd)"

  if [[ -f "$project_dir/nixcage.vm.nix" ]]; then
    log_warn "nixcage.vm.nix already exists in $project_dir"
    log_warn "Remove it first, or run 'nixcage destroy' before re-initializing."
    exit 1
  fi

  local nix_system
  nix_system="$(detect_nix_system)"

  local hypervisor share_proto
  if [[ "$OS" == "linux" ]]; then
    hypervisor="cloud-hypervisor"
    share_proto="virtiofs"
  else
    hypervisor="qemu"
    share_proto="9p"
  fi

  mkdir -p "$project_dir/$NIXCAGE_VM_DIR"

  # Generate a project-specific ed25519 key pair; private key is gitignored.
  ssh-keygen -t ed25519 \
    -f "$project_dir/$NIXCAGE_VM_DIR/id_ed25519" \
    -N "" \
    -C "nixcage-vm-$(basename "$project_dir")" \
    -q

  local pub_key
  pub_key="$(cat "$project_dir/$NIXCAGE_VM_DIR/id_ed25519.pub")"

  local ssh_port
  ssh_port="$(vm_free_port)"

  local detected_keys
  detected_keys="$(vm_detect_ai_keys)"
  local secret_vars="${detected_keys// /,}"

  # Write per-project runtime state; gitignored so keys and ports never land
  # in source control.
  cat >"$project_dir/$NIXCAGE_VM_DIR/config" <<EOF
SSH_PORT=${ssh_port}
SECRET_VARS=${secret_vars}
HYPERVISOR=${hypervisor}
SHARE_PROTO=${share_proto}
NIX_SYSTEM=${nix_system}
EOF

  # Add .nixcage-vm/ to the project root .gitignore so generated state never
  # lands in source control. Idempotent -- skips if the line already exists.
  local root_gitignore="$project_dir/.gitignore"
  if ! grep -qxF '.nixcage-vm/' "$root_gitignore" 2>/dev/null; then
    printf '\n.nixcage-vm/\n' >>"$root_gitignore"
  fi

  # Write the generated VM flake that wires microvm.nix + base module + user config.
  cat >"$project_dir/$NIXCAGE_VM_DIR/flake.nix" <<FLAKE
## Auto-generated by nixcage init -- re-run 'nixcage init' to regenerate
{
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    nixcage = {
      url = "github:hamidr/nixcage";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    microvm = {
      url = "github:astro/microvm.nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, nixcage, microvm, ... }: {
    nixosConfigurations.vm = nixpkgs.lib.nixosSystem {
      system = "${nix_system}";
      modules = [
        microvm.nixosModules.microvm
        nixcage.nixosModules.base
        ./nixcage.vm.nix
        {
          microvm = {
            hypervisor = "${hypervisor}";
            mem = 2048;
            vcpu = 2;
            shares = [{
              tag = "workspace";
              source = "${project_dir}";
              mountPoint = "/workspace";
              proto = "${share_proto}";
            }];
            interfaces = [{
              type = "user";
              id = "nixcage0";
              mac = "02:00:00:00:00:01";
            }];
            forwardPorts = [{
              from = "host";
              host.port = ${ssh_port};
              guest.port = 22;
            }];
          };
          users.users.nixcage.openssh.authorizedKeys.keys = [
            "${pub_key}"
          ];
        }
      ];
    };
  };
}
FLAKE

  # Write the user-facing config template committed to the project repo.
  cat >"$project_dir/nixcage.vm.nix" <<'VMCONF'
## nixcage VM configuration -- edit to customize your environment.
## Run 'nixcage sync' after changes.
{ pkgs, ... }: {

  ## Add project-specific packages
  # environment.systemPackages = with pkgs; [
  #   python3
  #   rustup
  #   postgresql
  # ];

  ## Adjust VM resources (defaults: 2 GB RAM, 2 vCPUs)
  # microvm.mem = 4096;
  # microvm.vcpu = 4;

  ## Mount extra host paths (proto: "virtiofs" on Linux, "9p" on macOS)
  # microvm.shares = [{
  #   tag = "home-ssh";
  #   source = "/home/me/.ssh";
  #   mountPoint = "/home/nixcage/.ssh";
  #   proto = "virtiofs";
  # }];
}
VMCONF

  log_ok "Initialized nixcage VM project in $project_dir"
  log_info ""
  log_info "  VM config:    nixcage.vm.nix     <- edit to add packages, resources"
  log_info "  SSH port:     $ssh_port"
  if [[ -n "$secret_vars" ]]; then
    log_info "  Secrets:      $secret_vars"
  fi
  log_info ""
  log_info "Next steps:"
  log_info "  1. nixcage build              (once; first run takes 15+ minutes)"
  log_info "  2. nixcage install-hook       (adds auto-enter hook to shell rc)"
  log_info "  3. nixcage shell              (starts VM if needed, then enters it)"
}

cmd_build() {
  local project_dir
  project_dir="$(find_vm_root)"

  if [[ ! -f "$project_dir/$NIXCAGE_VM_DIR/flake.nix" ]]; then
    log_err "No .nixcage-vm/flake.nix found. Run 'nixcage init' first."
    exit 1
  fi

  # Copy user config into the flake tree so Nix pure evaluation can see it.
  cp "$project_dir/nixcage.vm.nix" "$project_dir/$NIXCAGE_VM_DIR/nixcage.vm.nix"

  log_info "Building VM (first build takes 15+ minutes)..."
  (cd "$project_dir/$NIXCAGE_VM_DIR" && \
    nix build .#nixosConfigurations.vm.config.microvm.declaredRunner --out-link result -L)

  # Record a hash of the inputs so 'nixcage start' can warn on staleness.
  vm_compute_build_hash "$project_dir" >"$project_dir/$NIXCAGE_VM_DIR/build-hash"

  log_ok "VM built. Run 'nixcage shell' to enter the VM."
}

cmd_start() {
  local project_dir
  project_dir="$(find_vm_root)"

  if vm_is_running "$project_dir"; then
    log_warn "VM is already running."
    return 0
  fi

  local result="$project_dir/$NIXCAGE_VM_DIR/result"
  if [[ ! -L "$result" && ! -e "$result" ]]; then
    log_err "VM not built. Run 'nixcage build' first."
    exit 1
  fi

  # Warn (don't block) when nixcage.vm.nix changed since the last build.
  local build_hash_file="$project_dir/$NIXCAGE_VM_DIR/build-hash"
  if [[ -f "$build_hash_file" ]]; then
    local current_hash
    current_hash="$(vm_compute_build_hash "$project_dir")"
    local stored_hash
    stored_hash="$(cat "$build_hash_file")"
    if [[ "$current_hash" != "$stored_hash" ]]; then
      log_warn "nixcage.vm.nix changed since last build -- run 'nixcage sync' to apply"
    fi
  fi

  local runner
  runner="$(readlink -f "$result")"
  if [[ ! -x "$runner" ]]; then
    log_err "VM runner is not executable: $runner"
    exit 1
  fi

  local log_file="$project_dir/$NIXCAGE_VM_DIR/vm.log"
  local pid_file
  pid_file="$(vm_pid_file "$project_dir")"

  log_info "Starting VM..."
  "$runner" >"$log_file" 2>&1 &
  echo "$!" >"$pid_file"

  vm_wait_for_ssh "$project_dir"
  vm_bootstrap_known_hosts "$project_dir"
  vm_inject_secrets "$project_dir"

  log_ok "VM ready. Use 'nixcage shell' to enter or 'nixcage stop' to stop."
}

cmd_stop() {
  local project_dir
  project_dir="$(find_vm_root)"

  if ! vm_is_running "$project_dir"; then
    log_warn "VM is not running."
    return 0
  fi

  local pid_file
  pid_file="$(vm_pid_file "$project_dir")"
  local pid
  pid="$(cat "$pid_file")"

  log_info "Stopping VM (pid $pid)..."
  kill "$pid" 2>/dev/null || true

  local deadline=$((SECONDS + 10))
  while [[ $SECONDS -lt $deadline ]]; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done

  if kill -0 "$pid" 2>/dev/null; then
    log_warn "VM did not stop gracefully; forcing kill."
    kill -9 "$pid" 2>/dev/null || true
  fi

  rm -f "$pid_file"
  log_ok "VM stopped."
}

cmd_shell() {
  local project_dir
  project_dir="$(find_vm_root)"

  if ! vm_is_running "$project_dir"; then
    cmd_start
  fi

  log_info "Entering VM..."
  vm_ssh "$project_dir"
}

cmd_run() {
  if [[ $# -eq 0 ]]; then
    log_err "Usage: nixcage run <command> [args...]"
    exit 1
  fi

  local project_dir
  project_dir="$(find_vm_root)"

  if ! vm_is_running "$project_dir"; then
    cmd_start
  fi

  vm_ssh "$project_dir" -- "$@"
}

cmd_sync() {
  local project_dir
  project_dir="$(find_vm_root)"

  local build_hash_file="$project_dir/$NIXCAGE_VM_DIR/build-hash"
  local current_hash
  current_hash="$(vm_compute_build_hash "$project_dir")"

  if [[ -f "$build_hash_file" ]]; then
    local stored_hash
    stored_hash="$(cat "$build_hash_file")"
    if [[ "$current_hash" == "$stored_hash" ]]; then
      log_ok "VM is up to date. Nothing to do."
      return 0
    fi
  fi

  log_info "Changes detected. Rebuilding..."
  cmd_build

  if vm_is_running "$project_dir"; then
    cmd_stop
    cmd_start
  fi
}

cmd_logs() {
  local project_dir
  project_dir="$(find_vm_root)"

  local log_file="$project_dir/$NIXCAGE_VM_DIR/vm.log"
  if [[ ! -f "$log_file" ]]; then
    log_err "No VM log found. Has the VM been started?"
    exit 1
  fi

  tail -f "$log_file"
}

cmd_status() {
  local project_dir
  project_dir="$(find_vm_root)" 2>/dev/null || {
    log_warn "Not inside a nixcage VM project."
    exit 1
  }

  vm_read_config "$project_dir"

  local built="no"
  [[ -e "$project_dir/$NIXCAGE_VM_DIR/result" ]] && built="yes"

  local running="no"
  local pid=""
  if vm_is_running "$project_dir"; then
    running="yes"
    pid="$(cat "$(vm_pid_file "$project_dir")")"
  fi

  local ssh_reachable="no"
  if [[ "$running" == "yes" ]]; then
    vm_ssh "$project_dir" true 2>/dev/null && ssh_reachable="yes" || true
  fi

  local stale=""
  if [[ "$built" == "yes" ]]; then
    local build_hash_file="$project_dir/$NIXCAGE_VM_DIR/build-hash"
    if [[ -f "$build_hash_file" ]]; then
      local current_hash stored_hash
      current_hash="$(vm_compute_build_hash "$project_dir")"
      stored_hash="$(cat "$build_hash_file")"
      [[ "$current_hash" != "$stored_hash" ]] && stale=" (stale -- run 'nixcage sync')"
    fi
  fi

  echo "${BOLD}nixcage status${NC}"
  echo "  Project:    $project_dir"
  echo "  Nix system: ${VM_NIX_SYSTEM:-unknown}"
  echo "  Hypervisor: ${VM_HYPERVISOR:-unknown}"
  echo "  Share:      ${VM_SHARE_PROTO:-unknown}"
  echo "  SSH port:   ${VM_SSH_PORT:-unknown}"
  echo "  Built:      ${built}${stale}"
  echo "  Running:    $running${pid:+ (pid $pid)}"
  echo "  SSH:        $ssh_reachable"
}

cmd_install_hook() {
  local remove=false
  for arg in "$@"; do
    [[ "$arg" == "--remove" ]] && remove=true
  done

  local shell_name
  shell_name="$(basename "$SHELL")"

  local rc_file hook_block
  # shellcheck disable=SC2016
  case "$shell_name" in
  zsh)
    rc_file="$HOME/.zshrc"
    # shellcheck disable=SC2016
    hook_block='# nixcage-hook-begin
_nixcage_chpwd() {
  [[ -f "$PWD/nixcage.vm.nix" ]] || return
  [[ -n "${NIXCAGE_VM_ACTIVE:-}" ]] && return
  export NIXCAGE_VM_ACTIVE=1
  nixcage shell
  unset NIXCAGE_VM_ACTIVE
}
autoload -U add-zsh-hook
add-zsh-hook chpwd _nixcage_chpwd
# nixcage-hook-end'
    ;;
  bash)
    rc_file="$HOME/.bashrc"
    # shellcheck disable=SC2016
    hook_block='# nixcage-hook-begin
_nixcage_last_dir=""
_nixcage_prompt() {
  [[ "$PWD" == "$_nixcage_last_dir" ]] && return
  _nixcage_last_dir="$PWD"
  [[ -f "$PWD/nixcage.vm.nix" ]] || return
  [[ -n "${NIXCAGE_VM_ACTIVE:-}" ]] && return
  export NIXCAGE_VM_ACTIVE=1
  nixcage shell
  unset NIXCAGE_VM_ACTIVE
}
PROMPT_COMMAND="_nixcage_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
# nixcage-hook-end'
    ;;
  *)
    log_err "Unsupported shell: $shell_name (only zsh and bash are supported)"
    exit 1
    ;;
  esac

  if $remove; then
    if ! grep -q '# nixcage-hook-begin' "$rc_file" 2>/dev/null; then
      log_warn "No nixcage hook found in $rc_file"
      return 0
    fi
    # Portable in-place deletion using a temp file
    sed '/# nixcage-hook-begin/,/# nixcage-hook-end/d' "$rc_file" >"${rc_file}.tmp"
    mv "${rc_file}.tmp" "$rc_file"
    log_ok "Removed nixcage hook from $rc_file"
    return 0
  fi

  if grep -q '# nixcage-hook-begin' "$rc_file" 2>/dev/null; then
    log_ok "nixcage hook already present in $rc_file"
    return 0
  fi

  printf '\n%s\n' "$hook_block" >>"$rc_file"
  log_ok "Added nixcage hook to $rc_file"
  log_info "Restart your shell or run: source $rc_file"
}

# Echo hook code to stdout for manual eval-based installation.
cmd_vm_hook() {
  local shell_name="${1:-$(basename "$SHELL")}"
  case "$shell_name" in
  zsh)
    cat <<'HOOK'
_nixcage_chpwd() {
  [[ -f "$PWD/nixcage.vm.nix" ]] || return
  [[ -n "${NIXCAGE_VM_ACTIVE:-}" ]] && return
  export NIXCAGE_VM_ACTIVE=1
  nixcage shell
  unset NIXCAGE_VM_ACTIVE
}
autoload -U add-zsh-hook
add-zsh-hook chpwd _nixcage_chpwd
HOOK
    ;;
  bash)
    cat <<'HOOK'
_nixcage_last_dir=""
_nixcage_prompt() {
  [[ "$PWD" == "$_nixcage_last_dir" ]] && return
  _nixcage_last_dir="$PWD"
  [[ -f "$PWD/nixcage.vm.nix" ]] || return
  [[ -n "${NIXCAGE_VM_ACTIVE:-}" ]] && return
  export NIXCAGE_VM_ACTIVE=1
  nixcage shell
  unset NIXCAGE_VM_ACTIVE
}
PROMPT_COMMAND="_nixcage_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
HOOK
    ;;
  *)
    log_err "Unsupported shell: $shell_name (zsh or bash)"
    exit 1
    ;;
  esac
}

cmd_destroy() {
  local dir="${1:-.}"
  local project_dir
  project_dir="$(cd "$dir" && pwd)"

  if vm_is_running "$project_dir" 2>/dev/null; then
    log_info "Stopping VM before destroy..."
    (cd "$project_dir" && cmd_stop)
  fi

  local removed=false
  if [[ -f "$project_dir/nixcage.vm.nix" ]]; then
    rm -f "$project_dir/nixcage.vm.nix"
    removed=true
  fi
  if [[ -d "$project_dir/$NIXCAGE_VM_DIR" ]]; then
    rm -rf "${project_dir:?}/$NIXCAGE_VM_DIR"
    removed=true
  fi

  # Remove the .nixcage-vm/ entry from .gitignore if present.
  local root_gitignore="$project_dir/.gitignore"
  if grep -qxF '.nixcage-vm/' "$root_gitignore" 2>/dev/null; then
    grep -vxF '.nixcage-vm/' "$root_gitignore" >"${root_gitignore}.tmp"
    mv "${root_gitignore}.tmp" "$root_gitignore"
  fi

  if $removed; then
    log_ok "Removed all nixcage files from $project_dir"
  else
    log_warn "No nixcage files found in $project_dir"
  fi
}

cmd_help() {
  cat <<HELP
${BOLD}nixcage${NC} v${NIXCAGE_VERSION} -- NixOS microVM environments for AI coding agents

${BOLD}Usage:${NC}
  nixcage <command> [args...]

${BOLD}Commands:${NC}
  init [dir]        Initialize a new VM project
  build             Build the VM image (run once after init)
  start             Start the VM in the background
  stop              Stop the VM
  shell             Enter an interactive VM shell (starts if needed)
  run <cmd...>      Run a command inside the VM
  sync              Rebuild and restart if configuration changed
  logs              Tail the VM log
  status            Show VM state
  install-hook      Add the cd auto-enter hook to your shell rc file
  destroy [dir]     Remove all nixcage files
  version           Print version
  help              Show this help

${BOLD}Quick start:${NC}
  nixcage init
  nixcage build                  # once; ~15 min first run
  nixcage install-hook           # adds hook to ~/.zshrc or ~/.bashrc
  cd .                           # trigger the hook
HELP
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
  init)         cmd_init "$@" ;;
  build)        cmd_build "$@" ;;
  start)        cmd_start "$@" ;;
  stop)         cmd_stop "$@" ;;
  shell)        cmd_shell "$@" ;;
  run)          cmd_run "$@" ;;
  sync)         cmd_sync "$@" ;;
  logs)         cmd_logs "$@" ;;
  status)       cmd_status "$@" ;;
  install-hook) cmd_install_hook "$@" ;;
  destroy)      cmd_destroy "$@" ;;
  _vm_hook)     cmd_vm_hook "$@" ;;
  version | --version | -v) echo "nixcage $NIXCAGE_VERSION" ;;
  help | --help | -h) cmd_help ;;
  *)
    log_err "Unknown command: $command"
    cmd_help
    exit 1
    ;;
  esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
