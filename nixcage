#!/usr/bin/env bash
# nixcage -- per-project NixOS containers for AI coding agents

set -euo pipefail

NIXCAGE_VERSION="5.1.6"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

log_info() { echo -e "${CYAN}[nixcage]${NC} $*"; }
log_ok()   { echo -e "${GREEN}[nixcage]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[nixcage]${NC} $*"; }
log_err()  { echo -e "${RED}[nixcage]${NC} $*" >&2; }

require_cmd() {
  local cmd="$1"
  local hint="${2:-}"
  if ! command -v "$cmd" &>/dev/null; then
    log_err "'$cmd' is required but not found."
    [[ -n "$hint" ]] && log_err "  $hint"
    exit 1
  fi
}

detect_os() {
  case "$(uname -s)" in
  Linux*)  echo "linux" ;;
  Darwin*) echo "macos" ;;
  *)
    log_err "Unsupported OS: $(uname -s)"
    exit 1
    ;;
  esac
}

# NIXCAGE_OS is a test override; real installs branch on the actual OS.
OS="${NIXCAGE_OS:-$(detect_os)}"

# The config flake is user-owned; the CLI never writes into it. It is the
# macOS configuration source; on Linux the host's nixosModules.host renders
# /etc/nixcage/config instead and there is no VM.
NIXCAGE_FLAKE="${NIXCAGE_FLAKE:-$HOME/.config/nixcage}"
# What a host declared, read through the same module the guest script reads it
# with. Sourced rather than copied: two readers of one format is the thing
# this replaced. The package names the file; a working tree has it beside the
# script.
NIXCAGE_DECLARATION_SH="${NIXCAGE_DECLARATION_SH:-$(dirname "${BASH_SOURCE[0]}")/modules/declaration.sh}"
# The path is a variable, so shellcheck cannot follow it from here; the dev
# shell lints the file itself.
# shellcheck disable=SC1090
source "$NIXCAGE_DECLARATION_SH"

HOST_CONFIG="${NIXCAGE_HOST_CONFIG:-/etc/nixcage/declaration}"
# The two files a nixcage before this one rendered, read when the declaration
# is absent so a CLI newer than the module it stands on does not take a host
# with workspace roots for a host with none.
LEGACY_HOST_CONFIG="${NIXCAGE_LEGACY_HOST_CONFIG:-/etc/nixcage/config}"
LEGACY_CONTAINER_CONFIG="${NIXCAGE_LEGACY_CONTAINER_CONFIG:-/etc/nixcage/container}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nixcage"

# All values the CLI needs from the config flake, cached at build time so
# 'enter' does not pay a nix eval on every invocation.
CACHE_FILE="$STATE_DIR/cache"

# Pick the VM configuration like nixos-rebuild picks a host: prefer
# nixosConfigurations."nixcage-<hostname>" so one flake can serve several
# machines, fall back to nixosConfigurations.nixcage.
resolve_vm_attr() {
  local host
  host="$(hostname -s)"
  if nix eval "$NIXCAGE_FLAKE#nixosConfigurations" \
       --apply "c: c ? \"nixcage-$host\"" 2>/dev/null | grep -qx true; then
    echo "nixosConfigurations.\"nixcage-$host\".config"
  else
    echo "nixosConfigurations.nixcage.config"
  fi
}

check_flake() {
  # A path flake must contain flake.nix; other refs (git urls) are taken
  # as-is and nix reports their errors.
  if [[ "$NIXCAGE_FLAKE" == /* && ! -f "$NIXCAGE_FLAKE/flake.nix" ]]; then
    log_err "No config flake at $NIXCAGE_FLAKE"
    log_err "Create one with: nix flake new -t github:hamidr/nixcage ~/.config/nixcage"
    log_err "Or point --flake / NIXCAGE_FLAKE at an existing one."
    exit 1
  fi
}

# Load configuration into VM_* globals from the platform's source: the
# host-rendered /etc/nixcage/config on Linux, the build-time cache on macOS.
cfg_read() {
  if [[ "$OS" == "linux" ]]; then
    host_read_config
  else
    vm_read_cache
  fi
}

# Read what nixosModules.host rendered, once per invocation. A host that
# declared nothing is not an error: it gets the undeclared answer to every
# setting the file would carry, which for the roots is no roots at all. A
# declaration this nixcage cannot read is an error, because a host with roots
# must never be taken for a host with none.
#
# Once, because every verb asks whether this host declared anything and the
# answer cannot depend on which verb asked first.
declaration_read_once() {
  [[ -z "${NIXCAGE_DECLARATION_READ:-}" ]] || return 0
  local status=0
  nixcage_declaration_read "$HOST_CONFIG" || status=$?
  if [[ "$status" == 2 ]]; then
    exit 1
  fi
  if [[ -z "${NIXCAGE_DECLARED:-}" ]]; then
    nixcage_declaration_read_legacy "$LEGACY_HOST_CONFIG" "$LEGACY_CONTAINER_CONFIG"
    if [[ -n "${NIXCAGE_DECLARATION_LEGACY:-}" ]]; then
      log_warn "Reading a declaration an older nixcage rendered."
      log_warn "Apply the matching nixcage with nixos-rebuild switch for the current one."
    fi
  fi
  NIXCAGE_DECLARATION_READ=1
}

# Whether this machine has been told anything about nixcage. The answer comes
# from the one reader, which is also what makes "what does this mean where
# nothing was declared" a question with one place to answer it.
host_declared() {
  declaration_read_once
  [[ -n "${NIXCAGE_DECLARED:-}" ]]
}

host_read_config() {
  declaration_read_once
  VM_WORKSPACE_ROOTS="${WORKSPACE_ROOTS:-}"
}

# Read the build-time cache (SSH_PORT, WORKSPACE_ROOTS) into globals.
vm_read_cache() {
  if [[ ! -f "$CACHE_FILE" ]]; then
    log_err "VM has not been built yet. Run 'nixcage rebuild' first."
    exit 1
  fi
  VM_SSH_PORT=""
  VM_WORKSPACE_ROOTS=""
  local key val
  while IFS='=' read -r key val || [[ -n "$key" ]]; do
    case "$key" in
    SSH_PORT)        VM_SSH_PORT="$val" ;;
    WORKSPACE_ROOTS) VM_WORKSPACE_ROOTS="$val" ;;
    esac
  done <"$CACHE_FILE"
}

vm_pid_file() { echo "$STATE_DIR/vm.pid"; }
vm_virtiofsd_pid_file() { echo "$STATE_DIR/virtiofsd.pid"; }

# How long to wait for the guest to shut itself down before signalling qemu,
# and then for qemu to exit before killing it. Overridable because the test
# suite drives them with stubs and must not sit out the real waits.
VM_SHUTDOWN_TIMEOUT="${NIXCAGE_SHUTDOWN_TIMEOUT:-30}"
VM_KILL_TIMEOUT="${NIXCAGE_KILL_TIMEOUT:-10}"

# Wait up to $2 seconds for process $1 to disappear. Answers whether it did.
vm_wait_for_exit() {
  local pid="$1" deadline=$((SECONDS + $2))
  while [[ $SECONDS -lt $deadline ]]; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 1
  done
  ! kill -0 "$pid" 2>/dev/null
}

# The pid must both be alive and still look like the VM runner: after a
# host reboot the state file survives and the pid can be reused by an
# unrelated process, which 'down' would otherwise kill.
vm_is_running() {
  local pid_file
  pid_file="$(vm_pid_file)"
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || return 1
  if ! ps -p "$pid" -o args= 2>/dev/null | grep -qE 'microvm|qemu'; then
    rm -f "$pid_file"
    return 1
  fi
}

# True when something already listens on the given local TCP port.
port_in_use() {
  local port="$1"
  (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || return 1
  exec 3>&- 3<&-
}

# Container names are passed to root-level rm -rf and into SSH command
# strings; reject anything beyond the derived-name alphabet.
validate_container_name() {
  [[ "$1" =~ ^[a-zA-Z0-9-]+$ ]]
}

# Generate the host keypair lazily on first use; the public key must be
# listed in nixcage.authorizedKeys in the config flake.
ensure_ssh_key() {
  local key="$STATE_DIR/id_ed25519"
  [[ -f "$key" ]] && return 0
  require_cmd "ssh-keygen"
  mkdir -p "$STATE_DIR"
  ssh-keygen -t ed25519 -f "$key" -N "" -C "nixcage@$(hostname)" -q
  log_ok "Generated SSH keypair at $key"
  log_warn "Add this public key to nixcage.authorizedKeys in your config flake:"
  echo
  cat "$key.pub"
  echo
}

vm_ssh() {
  vm_read_cache
  ssh -p "$VM_SSH_PORT" -i "$STATE_DIR/id_ed25519" \
    -o "UserKnownHostsFile=$STATE_DIR/known_hosts" \
    -o "StrictHostKeyChecking=yes" \
    -o "ConnectTimeout=5" \
    -o "BatchMode=yes" \
    "nixcage@127.0.0.1" "$@"
}

# Poll until SSH is reachable or the VM process dies.
# The VM's host key persists on its data volume, so accept-new trusts it
# once on first contact and every later boot is verified against it.
vm_wait_for_ssh() {
  vm_read_cache
  local known_hosts="$STATE_DIR/known_hosts"
  local key="$STATE_DIR/id_ed25519"
  local timeout=120
  [[ "$OS" == "macos" ]] && timeout=300
  local deadline=$((SECONDS + timeout))
  log_info "Waiting for VM SSH..."
  while [[ $SECONDS -lt $deadline ]]; do
    if ssh -p "$VM_SSH_PORT" -i "$key" \
         -o "UserKnownHostsFile=$known_hosts" \
         -o "StrictHostKeyChecking=accept-new" \
         -o "ConnectTimeout=5" \
         -o "BatchMode=yes" \
         "nixcage@127.0.0.1" true 2>/dev/null; then
      return 0
    fi
    if ! vm_is_running; then
      log_err "VM process died before SSH became reachable."
      log_err "Check $STATE_DIR/vm.log for details."
      exit 1
    fi
    sleep 2
  done
  log_err "Timed out waiting for VM SSH (${timeout}s)."
  exit 1
}

# Launch the virtiofsd processes backing the VM's virtiofs shares.
#
# microvm.nix generates result/bin/virtiofsd-run as a supervisord wrapper
# whose config sets `user=root`, so it refuses to start as a normal user.
# We bypass supervisord and exec each `command=` from the [program:...]
# sections directly, recording PIDs for cleanup.
#
# virtiofsd and qemu use a *relative* socket path, so both must share a
# CWD. Callers must cd to $STATE_DIR before invoking this and before
# launching the VM.
vm_start_virtiofsd() {
  local result="$1"
  local wrapper="$result/bin/virtiofsd-run"

  [[ -x "$wrapper" ]] || return 0

  local conf
  conf="$(grep -oE -- '--configuration[[:space:]]+\S+' "$wrapper" | awk '{print $2}')"
  if [[ -z "$conf" || ! -r "$conf" ]]; then
    log_err "virtiofsd-run wrapper references unreadable supervisord config: $conf"
    exit 1
  fi

  local pid_file
  pid_file="$(vm_virtiofsd_pid_file)"
  : >"$pid_file"
  local log_file="$STATE_DIR/virtiofsd.log"

  # Extract command= lines from [program:...] sections only.
  local in_program=0 line cmd
  while IFS= read -r line; do
    if [[ "$line" =~ ^\[program: ]]; then
      in_program=1
      continue
    elif [[ "$line" =~ ^\[ ]]; then
      in_program=0
      continue
    fi
    if [[ "$in_program" -eq 1 && "$line" =~ ^command= ]]; then
      cmd="${line#command=}"
      # microvm.nix hardcodes --socket-group=kvm; chgrp fails when the
      # invoking user isn't in the kvm group. Strip it so virtiofsd starts.
      bash <(sed 's/--socket-group=[^[:space:]]*//g' "$cmd") \
        >>"$log_file" 2>&1 &
      echo "$!" >>"$pid_file"
    fi
  done <"$conf"
}

vm_stop_virtiofsd() {
  local pid_file
  pid_file="$(vm_virtiofsd_pid_file)"
  [[ -f "$pid_file" ]] || return 0
  local pid
  while read -r pid; do
    [[ -n "$pid" ]] || continue
    kill "$pid" 2>/dev/null || true
  done <"$pid_file"
  rm -f "$pid_file"
  rm -f "$STATE_DIR"/nixcage-virtiofs-*.sock "$STATE_DIR"/*-virtiofs-*.sock
}

vm_build() {
  require_cmd "nix"
  check_flake
  mkdir -p "$STATE_DIR"

  local attr
  attr="$(resolve_vm_attr)"
  log_info "Building VM from $NIXCAGE_FLAKE#${attr%.config} (first build takes a while)..."
  nix build "$NIXCAGE_FLAKE#$attr.microvm.declaredRunner" \
    --out-link "$STATE_DIR/result" -L

  # Cache the config values the CLI needs at runtime so 'enter' stays free
  # of nix eval calls. The cache is regenerated on every rebuild.
  local port roots
  port="$(nix eval --raw "$NIXCAGE_FLAKE#$attr.nixcage.sshPort" --apply toString)"
  roots="$(nix eval --json "$NIXCAGE_FLAKE#$attr.nixcage.workspaceRoots" | jq -r 'join(":")')"
  cat >"$CACHE_FILE" <<EOF
SSH_PORT=$port
WORKSPACE_ROOTS=$roots
EOF

  # A rebuild may legitimately change the VM's persistent host key; a
  # stale entry would otherwise hard-fail every later connection.
  rm -f "$STATE_DIR/known_hosts"

  log_ok "VM built."
}

vm_start() {
  ensure_ssh_key

  local result="$STATE_DIR/result"
  if [[ ! -e "$result" ]]; then
    vm_build
  fi

  # A foreign listener on the SSH port would break qemu's forward -- or
  # worse, get trusted by the accept-new handshake meant for the VM.
  vm_read_cache
  if port_in_use "$VM_SSH_PORT"; then
    log_err "Port $VM_SSH_PORT is already in use on 127.0.0.1."
    log_err "Free it, or change nixcage.sshPort and run 'nixcage rebuild'."
    exit 1
  fi

  # Clear stale virtiofsd processes/sockets from a previous failed start.
  vm_stop_virtiofsd

  local runner
  if [[ -x "$result/bin/microvm-run" ]]; then
    runner="$(readlink -f "$result/bin/microvm-run")"
  else
    runner="$(readlink -f "$result")"
  fi
  if [[ ! -x "$runner" ]]; then
    log_err "VM runner is not executable: $runner"
    exit 1
  fi

  local log_file="$STATE_DIR/vm.log"
  local pid_file
  pid_file="$(vm_pid_file)"

  log_info "Starting VM..."
  (
    cd "$STATE_DIR"
    vm_start_virtiofsd "$result"
    "$runner" >"$log_file" 2>&1 &
    echo "$!" >"$pid_file"
  )

  # vm_wait_for_ssh exits on failure, which would orphan the hypervisor
  # (still holding the SSH port and blocking every later start) and
  # virtiofsd. An EXIT trap cleans both up only when ssh did not succeed.
  _nixcage_start_ok=0
  trap '[[ $_nixcage_start_ok -eq 1 ]] || { kill "$(cat "$(vm_pid_file)" 2>/dev/null)" 2>/dev/null; rm -f "$(vm_pid_file)"; vm_stop_virtiofsd; }' EXIT
  vm_wait_for_ssh
  _nixcage_start_ok=1
  trap - EXIT

  log_ok "VM ready."
}

ensure_vm() {
  vm_is_running || vm_start
}

# Derive a stable container name from the project path: sanitized basename
# plus a short hash so distinct paths with equal basenames never collide.
container_name_for() {
  local project_dir="$1"
  local base hash
  base="$(basename "$project_dir" | tr -cs 'a-zA-Z0-9' '-')"
  base="${base#-}"
  base="${base%-}"
  hash="$(printf '%s' "$project_dir" | sha256sum | awk '{print substr($1, 1, 8)}')"
  echo "${base:-project}-${hash}"
}

# Verify the path sits under a configured workspace root; on macOS the
# roots are mounted at identical paths inside the VM, so the same path is
# valid on both sides. On Linux the containers run on the host directly.
## What a directory has to be to be a cage where no root was declared: the
## caller standing in it is the consent, so the check is only for the
## directories that answer is never meant for. The ownership test is the one
## the session already depends on, since a cage runs as the owner of its
## project.
check_undeclared_project() {
  local project_dir="$1"
  case "$project_dir" in
  / | /nix | /nix/store)
    log_err "$project_dir is not a project."
    log_err "With no host config the cage is the directory you are standing in."
    exit 1
    ;;
  esac
  if [[ -n "${HOME:-}" && "$project_dir" == "$HOME" ]]; then
    log_err "$project_dir is your home directory, not a project."
    exit 1
  fi
  if [[ ! -O "$project_dir" ]]; then
    log_err "$project_dir is not owned by you; a cage runs as the owner of its project."
    exit 1
  fi
}

check_workspace_root() {
  local project_dir="$1"
  cfg_read
  # A host that declared no roots has not declared a boundary either, so the
  # directory the caller is in is the cage. Answered here rather than in
  # enter, so that a cage made from a directory is removable from it.
  if [[ "$OS" == "linux" ]] && ! host_declared; then
    check_undeclared_project "$project_dir"
    return 0
  fi
  local root
  IFS=':' read -ra _roots <<<"$VM_WORKSPACE_ROOTS"
  for root in "${_roots[@]}"; do
    [[ -n "$root" ]] || continue
    if [[ "$project_dir" == "$root" || "$project_dir" == "$root"/* ]]; then
      return 0
    fi
  done
  log_err "$project_dir is not under any workspace root ($VM_WORKSPACE_ROOTS)."
  log_err "Add the root to nixcage.workspaceRoots and apply your configuration."
  exit 1
}

## What runs where the cages are, and what a session is built from. A host
## that imported the module installed the layer and the symlink to it, so the
## name on PATH and the file it reads are the answer. Where nothing was
## declared there is neither, and the answer is what this nixcage was built
## with: the store paths the package baked in, which is why the container
## layer is in what `nix run` fetches.
container_words() {
  if host_declared; then
    echo nixcage-container
    return 0
  fi
  if [[ -z "${NIXCAGE_CONTAINER:-}" ]]; then
    log_err "This nixcage carries no container layer to run a session from."
    log_err "Run it from the store: nix run github:hamidr/nixcage -- enter"
    log_err "Or import nixcage's nixosModules.host and rebuild."
    # Inside a command substitution an exit ends only the subshell, so the
    # status is what the caller acts on.
    return 1
  fi
  echo "$NIXCAGE_CONTAINER"
}

## Who a session commits as where no module rendered an identity (ADR-023
## decision 11). The two fields are read from the invoking user's git and
## handed over; ~/.gitconfig itself is never bound into a cage, because it
## carries credential.helper and signing configuration (ADR-008).
git_identity_args() {
  host_declared && return 0
  local name email
  name="$(git config --get user.name 2>/dev/null || true)"
  email="$(git config --get user.email 2>/dev/null || true)"
  [[ -n "$name" ]] && { echo --git-name; echo "$name"; }
  [[ -n "$email" ]] && { echo --git-email; echo "$email"; }
  return 0
}

## Where nixcage's own outputs are realised from, when a session needs one
## this nixcage did not carry. Overridable so the suite and a working tree can
## point it at themselves.
NIXCAGE_SELF_FLAKE="${NIXCAGE_SELF_FLAKE:-github:hamidr/nixcage}"

MICROVM_CACHE="$STATE_DIR/microvm"

## The revision the host is already running, where it can name one. A guest
## built against it shares the machine's glibc, systemd, bash and kernel
## instead of fetching a second set (ADR-023 decision 9).
host_nixpkgs_revision() {
  command -v nixos-version >/dev/null 2>&1 || return 0
  nixos-version --json 2>/dev/null | jq -r '.nixpkgsRevision // empty' 2>/dev/null || true
}

## systemd-vmspawn searches PATH for qemu-system-<arch> and supports no other
## backend, so a machine that already runs virtual machines needs nothing from
## nixcage (ADR-023 decision 7).
machine_has_qemu() {
  command -v "qemu-system-$(uname -m)" >/dev/null 2>&1
}

## One output path of a flake attribute, realised now.
nix_out_path() {
  local out
  out="$(nix build --no-link --print-out-paths "$@")" || return 1
  [[ -n "$out" ]] || return 1
  tail -n 1 <<<"$out"
}

## What a microVM session needs that no declaration put on this machine: the
## guest it boots, virtiofsd for its shares, and qemu where the machine has
## none of its own. Realised when a session first asks for one and cached
## after that, so a caller who never boots a microVM never pays for one
## (ADR-023 decision 6). Answers the flags the session is given.
microvm_cached_args() {
  [[ -s "$MICROVM_CACHE" ]] || return 1
  local key path
  # A path the store no longer holds is not a cache entry: it was collected,
  # and the session would be given a name nothing answers to.
  while IFS='=' read -r key path; do
    [[ -e "$path" ]] || return 1
  done <"$MICROVM_CACHE"
  while IFS='=' read -r key path; do
    case "$key" in
    GUEST) echo --guest; echo "$path" ;;
    PATH)  echo --microvm-path; echo "$path" ;;
    esac
  done <"$MICROVM_CACHE"
}

## Realise what is missing. Separate from reading the cache because it
## prompts, prints and may refuse: a function whose output is captured cannot
## do any of the three, and its exit would only end the subshell doing the
## capturing.
microvm_realise() {
  if microvm_cached_args >/dev/null; then
    return 0
  fi

  local want_qemu=""
  machine_has_qemu || want_qemu=1

  # Announced before it is spent: undeclared, this is the one thing nixcage
  # does that costs more than the session it was asked for.
  log_warn "This host declared nothing, so a microVM session is built here first."
  log_warn "  the guest:  204 derivations, 302.2 MiB of downloads"
  log_warn "  virtiofsd:  44 MiB"
  log_warn "  openssh:    74 MiB, what exec and the agent forward use"
  [[ -n "$want_qemu" ]] &&
    log_warn "  qemu:       1450 MiB (this machine has no qemu-system-$(uname -m) of its own)"
  read -rp "Realise them now? [y/N] " answer
  if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
    log_err "Nothing realised. A microVM session needs them; an nspawn session does not."
    exit 1
  fi

  local rev guest="" virtiofsd qemu
  rev="$(host_nixpkgs_revision)"
  if [[ -n "$rev" ]]; then
    guest="$(nix_out_path "$NIXCAGE_SELF_FLAKE#guest" \
      --override-input nixpkgs "github:NixOS/nixpkgs/$rev")" || guest=""
    if [[ -z "$guest" ]]; then
      log_warn "The guest does not evaluate against this host's revision ($rev); using nixcage's own input."
    fi
  else
    log_info "This host names no nixpkgs revision, so the guest is built from nixcage's own input."
  fi
  if [[ -z "$guest" ]]; then
    guest="$(nix_out_path "$NIXCAGE_SELF_FLAKE#guest")" || {
      log_err "Could not realise the guest a microVM session boots."
      exit 1
    }
  fi
  virtiofsd="$(nix_out_path "$NIXCAGE_SELF_FLAKE#virtiofsd")" || {
    log_err "Could not realise virtiofsd, which vmspawn shares a directory with."
    exit 1
  }
  # exec on a microVM cage and the agent forward are ssh over vsock, and the
  # session looks for that ssh on its own path.
  local openssh
  openssh="$(nix_out_path "$NIXCAGE_SELF_FLAKE#openssh")" || {
    log_err "Could not realise openssh, which exec and the agent forward use."
    exit 1
  }

  qemu=""
  if [[ -n "$want_qemu" ]]; then
    qemu="$(nix_out_path "$NIXCAGE_SELF_FLAKE#qemu")" || {
      log_err "Could not realise qemu, which is the only backend vmspawn has."
      exit 1
    }
  fi

  mkdir -p "$STATE_DIR"
  {
    echo "GUEST=$guest"
    echo "PATH=$virtiofsd"
    echo "PATH=$openssh"
    [[ -z "$qemu" ]] || echo "PATH=$qemu"
  } >"$MICROVM_CACHE"
}

## The layer a session names across sudo (ADR-023 decision 8). Empty on a
## declared host, which reads its own.
container_profile_args() {
  if host_declared || [[ -z "${NIXCAGE_PROFILE:-}" ]]; then
    return 0
  fi
  echo --profile
  echo "$NIXCAGE_PROFILE"
}

cmd_enter() {
  local project_dir="$PWD"

  # A project is any directory under a workspace root (ADR-021). The flake is
  # an environment the session offers to use, not the ticket that admits it,
  # so the root is the only thing validated here.
  check_workspace_root "$project_dir"

  local name
  name="$(container_name_for "$project_dir")"

  # The options a session takes. The CLI is a person's tool and
  # nixcage-container is a program's (ADR-009): what a person parameterises a
  # session with is handed through, and what a dependant parameterises one
  # with is refused by name, pointing at exec, rather than falling through to
  # become the command the session runs. Whether a value is usable is
  # nixcage-container's to say; what is checked here is only what would
  # otherwise boot a VM before being refused.
  #
  # Both spellings: --substrate microvm and --substrate=microvm. Matching the
  # word alone let the joined form fall through to the command, so a session
  # ran "--substrate=microvm" inside a cage on the substrate it was asking to
  # change, and said nothing.
  local -a session=()
  local flag word joined
  while :; do
    case "${1:-}" in
      --) break ;;
      --*=*) joined=1 flag="${1%%=*}" word="${1#*=}" ;;
      --*)   joined="" flag="$1" word="${2:-}" ;;
      *) break ;;
    esac

    case "$flag" in
      --no-agent|--print-argv)
        session+=("$flag")
        # A flag that takes no value consumes only itself, whatever followed.
        shift
        continue
        ;;
      --substrate|--disk|--memory|--cpus|--bind|--bind-ro|--setenv|--shell) ;;
      --uid|--user|--subject|--home|--network|--dns|--no-nix-daemon|--store-root|\
      --profile|--guest|--microvm-path|--git-name|--git-email)
        log_err "$flag parameterises a session on behalf of a dependant, not from here."
        log_err "Reach it with: nixcage exec -- nixcage-container enter $flag ... $name $project_dir"
        exit 1
        ;;
      *)
        log_err "Unknown flag: $flag"
        log_err "Run 'nixcage help' for what enter takes."
        exit 1
        ;;
    esac

    # What a value has to be to be worth booting a VM for. A flag given no
    # value at all reads as one given an empty one, so these two answer for
    # the missing word with the words they take rather than with a generic
    # complaint about arity.
    case "$flag $word" in
      "--substrate nspawn"|"--substrate microvm") ;;
      "--substrate "*) log_err "--substrate needs nspawn or microvm"; exit 1 ;;
      "--disk "[0-9]*) ;;
      "--disk "*) log_err "--disk needs a size such as 2G"; exit 1 ;;
    esac

    if [[ -z "$joined" && $# -lt 2 ]]; then
      log_err "$flag needs a value as the next word."
      exit 1
    fi
    session+=("$flag" "$word")

    if [[ -n "$joined" ]]; then shift; else shift 2; fi
  done

  # Accept both 'enter -- cmd...' and 'enter cmd...'.
  [[ "${1:-}" == "--" ]] && shift

  # A session signs its commits through the invoking user's ssh-agent, so
  # the socket is forwarded rather than any key material being copied in.
  # Without a reachable agent the session still enters and only signing
  # fails, which is the same outcome as running git with no key.
  local -a agent_fwd=()
  if [[ -n "${SSH_AUTH_SOCK:-}" && -e "${SSH_AUTH_SOCK}" ]]; then
    agent_fwd=(--auth-sock "$SSH_AUTH_SOCK")
  fi

  if [[ "$OS" == "linux" ]]; then
    local container
    container="$(container_words)"
    local -a profile=()
    local word
    while IFS= read -r word; do
      if [[ -n "$word" ]]; then profile+=("$word"); fi
    done < <(container_profile_args)
    # A microVM on a host that declared nothing has no guest to boot and no
    # hypervisor where vmspawn looks, so this session is where they are
    # realised. A cage already on the substrate is given what was realised
    # before, since its record makes it a microVM session without the flag.
    local -a identity=()
    while IFS= read -r word; do
      if [[ -n "$word" ]]; then identity+=("$word"); fi
    done < <(git_identity_args)
    local -a microvm=()
    if ! host_declared &&
       { [[ " ${session[*]-} " == *" microvm "* ]] || [[ -s "$MICROVM_CACHE" ]]; }; then
      microvm_realise
      while IFS= read -r word; do
        if [[ -n "$word" ]]; then microvm+=("$word"); fi
      done < <(microvm_cached_args)
    fi
    [[ $# -eq 0 ]] && log_info "Entering container $name..."
    sudo "$container" enter "${session[@]}" "${profile[@]}" "${microvm[@]}" \
      "${identity[@]}" "${agent_fwd[@]}" "$name" "$project_dir" "$@"
    return
  fi

  ensure_vm

  # Everything in the remote command is re-split by the remote shell, so
  # every word gets %q, not just the trailing command arguments.
  local remote=(sudo nixcage-container enter "${session[@]}")
  # The forwarded socket lives in the VM and is named by the remote shell,
  # so the expansion is deliberately left for it to perform.
  local -a ssh_fwd=()
  if [[ ${#agent_fwd[@]} -gt 0 ]]; then
    ssh_fwd=(-A)
    # shellcheck disable=SC2016  # the remote shell performs this expansion
    remote+=(--auth-sock '"$SSH_AUTH_SOCK"')
  fi
  remote+=("$(printf '%q' "$name")" "$(printf '%q' "$project_dir")")
  local arg
  for arg in "$@"; do
    remote+=("$(printf '%q' "$arg")")
  done

  if [[ $# -eq 0 ]]; then
    log_info "Entering container $name..."
    vm_ssh "${ssh_fwd[@]}" -t -- "${remote[@]}"
  else
    vm_ssh "${ssh_fwd[@]}" -- "${remote[@]}"
  fi
}

## What cages this machine has, with what each was given (ADR-017). The
## record has held this since the cage was entered and only the container
## script could show it; this is the verb a person uses.
##
## --json hands the records over untouched, one object per line, because a
## caller that wants fields wants them as nixcage wrote them, not as a column
## this reformatted.
cmd_list() {
  local json=""
  case "${1:-}" in
  --json) json=1 ;;
  "") ;;
  *)
    log_err "usage: nixcage list [--json]"
    exit 1
    ;;
  esac

  local records
  records="$(container_records)"

  if [[ -n "$json" ]]; then
    [[ -z "$records" ]] || printf '%s\n' "$records"
    return
  fi

  if [[ -z "$records" ]]; then
    log_info "No cages on this machine yet."
    return
  fi

  # A cage with no substrate in its record is an nspawn cage: absent is what
  # every record held before a cage could be anything else.
  local -a rows=("NAME SUBSTRATE STATE UID")
  local row
  while IFS= read -r row; do
    [[ -n "$row" ]] && rows+=("$row")
  done < <(jq -r '[.name, (.substrate // "nspawn"),
                   (if .leader then "running" else "stopped" end),
                   (.uid // "-")] | @tsv' <<<"$records" | tr '\t' ' ')

  # Padded here rather than by column(1), which is util-linux on one platform
  # and BSD on the other and is in this flake's dependencies on neither.
  local -a width=(0 0 0 0)
  local -a cell
  local i
  for row in "${rows[@]}"; do
    read -r -a cell <<<"$row"
    for i in 0 1 2 3; do
      local field="${cell[i]:-}"
      [[ "${#field}" -gt "${width[i]}" ]] && width[i]="${#field}"
    done
  done
  # A field the query left empty makes a row shorter than its header, and a
  # record nixcage did not write is a record nixcage did not check: the
  # columns read what is there and print a dash for what is not.
  for row in "${rows[@]}"; do
    read -r -a cell <<<"$row"
    printf '%-*s  %-*s  %-*s  %s\n' \
      "${width[0]}" "${cell[0]:--}" \
      "${width[1]}" "${cell[1]:--}" \
      "${width[2]}" "${cell[2]:--}" \
      "${cell[3]:--}"
  done
}

## The records as the container script prints them, wherever the cages are.
##
## On macOS the cages are inside the VM, and a question about them does not
## start one: a caller asking what exists gets told the machine holding the
## answer is off, rather than waiting out a boot it did not ask for.
container_records() {
  if [[ "$OS" == "linux" ]]; then
    local container
    container="$(container_words)" || exit 1
    sudo "$container" list --json
    return
  fi
  if ! vm_is_running; then
    log_err "The VM is not running, so nothing here can say what cages it holds."
    log_err "Start it with 'nixcage enter' in a project, or 'nixcage rebuild'."
    exit 1
  fi
  vm_ssh -- sudo nixcage-container list --json
}

## Run a command as root wherever this machine's cages are: here on Linux,
## and inside the shared VM on macOS. Exported because everything nixcage
## builds a session for lives on that side of the transport, and a dependant
## that had to reach it itself would need this machine's SSH key, its port and
## the layout of nixcage's own state.
##
## It is not a shell. Every word arrives as one argument, and on macOS every
## word is quoted for the remote shell, which re-splits the whole line rather
## than only the trailing arguments.
cmd_exec() {
  local tty="" agent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --tty) tty=1; shift ;;
    --agent) agent=1; shift ;;
    --) shift; break ;;
    *) break ;;
    esac
  done

  if [[ $# -eq 0 ]]; then
    log_err "usage: nixcage exec [--tty] [--agent] -- <command> [args...]"
    exit 1
  fi

  # sudo clears the environment, so the forwarded socket has to be carried
  # across it by name. The command reads SSH_AUTH_SOCK from its own
  # environment rather than being handed a path: on macOS the path is the
  # VM's, which nothing on this side can spell.
  local -a sudo_opts=()
  [[ -n "$agent" ]] && sudo_opts=(--preserve-env=SSH_AUTH_SOCK)

  # The one word this transport reads rather than carries. A host that
  # declared nothing has no nixcage-container on any path, only the layer this
  # nixcage carries, and a dependant that had to know which kind of host it
  # stands on would be knowing exactly what exec exists to hide. Every other
  # word, and a path that already names a container, is handed over as it is.
  if [[ "$1" == "nixcage-container" ]] && ! host_declared && [[ "$OS" == "linux" ]]; then
    local container
    container="$(container_words)" || exit 1
    set -- "$container" "${@:2}"
  fi

  if [[ "$OS" == "linux" ]]; then
    sudo "${sudo_opts[@]}" "$@"
    return
  fi

  ensure_vm

  local remote=(sudo "${sudo_opts[@]}") arg
  local -a ssh_opts=()
  [[ -n "$agent" ]] && ssh_opts+=(-A)
  [[ -n "$tty" ]] && ssh_opts+=(-t)
  for arg in "$@"; do
    remote+=("$(printf '%q' "$arg")")
  done
  vm_ssh "${ssh_opts[@]}" -- "${remote[@]}"
}
require_vm_platform() {
  if [[ "$OS" == "linux" ]]; then
    log_err "No VM on Linux -- containers run on the host."
    log_err "Apply configuration changes with nixos-rebuild instead."
    exit 1
  fi
}

cmd_down() {
  require_vm_platform
  if ! vm_is_running; then
    log_warn "VM is not running."
    vm_stop_virtiofsd
    return 0
  fi

  local pid
  pid="$(cat "$(vm_pid_file)")"

  log_info "Shutting the VM down (pid $pid)..."

  # Ask the guest to power itself off, so its filesystems are unmounted and
  # everything written is on disk before qemu goes. Killing qemu instead
  # leaves the last seconds of writes in the guest's page cache, which on ext4
  # cost whole worktrees and still costs those seconds on ZFS.
  #
  # The connection dies with the guest, so ssh reports failure whether the
  # shutdown worked or not. Only the process disappearing answers that.
  if [[ -f "$CACHE_FILE" ]]; then
    vm_ssh -- sudo poweroff >/dev/null 2>&1 || true
  fi

  if ! vm_wait_for_exit "$pid" "$VM_SHUTDOWN_TIMEOUT"; then
    log_warn "The VM did not shut down; stopping qemu."
    kill "$pid" 2>/dev/null || true
    if ! vm_wait_for_exit "$pid" "$VM_KILL_TIMEOUT"; then
      log_warn "VM did not stop gracefully; forcing kill."
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi

  rm -f "$(vm_pid_file)"
  vm_stop_virtiofsd
  log_ok "VM stopped."
}

cmd_rebuild() {
  require_vm_platform
  vm_build
  if vm_is_running; then
    log_warn "Restarting VM -- all container sessions will be interrupted."
    cmd_down
    vm_start
  fi
}

cmd_rm() {
  local name
  if [[ $# -gt 0 ]]; then
    name="$1"
    if ! validate_container_name "$name"; then
      log_err "Invalid container name: $name"
      exit 1
    fi
  else
    # Without a name this is the cage of the directory it was run from, and a
    # project is any directory under a workspace root (ADR-021). The root is
    # what says whether this is one, so it is what is asked.
    check_workspace_root "$PWD"
    name="$(container_name_for "$PWD")"
  fi

  # Confirm before ensure_vm: aborting must not boot a VM.
  log_warn "This deletes container '$name' and its persistent home."
  read -rp "Continue? [y/N] " answer
  if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
    log_info "Aborted."
    return 0
  fi

  if [[ "$OS" == "linux" ]]; then
    local container
    container="$(container_words)" || exit 1
    sudo "$container" rm "$name"
  else
    ensure_vm
    vm_ssh -- sudo nixcage-container rm "$name"
  fi
  log_ok "Removed container $name."
}

cmd_status() {
  echo "${BOLD}nixcage status${NC}"

  if [[ "$OS" == "linux" ]]; then
    host_read_config
    if host_declared; then
      echo "  Host config:  $HOST_CONFIG"
      echo "  Roots:        $VM_WORKSPACE_ROOTS"
    else
      # Two options have no undeclared equivalent, and a caller who is not
      # told reads their absence as a bug rather than as this mode (ADR-023).
      echo "  Host config:  nothing declared at $HOST_CONFIG"
      echo "  Cage:         $PWD, the directory you are standing in"
      echo "  Without one:  no secretEnv, since the host environment is never"
      echo "                read, and no principalSubjects, since a subject is"
      echo "                something a host declares"
    fi
    echo "  Containers:"
    local container
    container="$(container_words)" || exit 1
    sudo "$container" list 2>/dev/null | sed 's/^/    /' || true
    return
  fi

  echo "  Config flake: $NIXCAGE_FLAKE"

  local built="no"
  [[ -e "$STATE_DIR/result" ]] && built="yes"
  echo "  Built:        $built"

  local running="no" pid=""
  if vm_is_running; then
    running="yes"
    pid="$(cat "$(vm_pid_file)")"
  fi
  echo "  Running:      $running${pid:+ (pid $pid)}"

  if [[ -f "$CACHE_FILE" ]]; then
    vm_read_cache
    echo "  SSH port:     $VM_SSH_PORT"
    echo "  Roots:        $VM_WORKSPACE_ROOTS"
  fi

  if [[ "$running" == "yes" ]]; then
    local ssh_reachable="no"
    vm_ssh true 2>/dev/null && ssh_reachable="yes" || true
    echo "  SSH:          $ssh_reachable"
    if [[ "$ssh_reachable" == "yes" ]]; then
      echo "  Containers:"
      vm_ssh -- sudo nixcage-container list 2>/dev/null | sed 's/^/    /' || true
      local age_pub
      age_pub="$(vm_ssh -- sudo age-keygen -y /var/lib/nixcage/age.key 2>/dev/null || true)"
      if [[ -n "$age_pub" ]]; then
        echo "  Age key:      $age_pub"
      fi
    fi
  fi
}

cmd_help() {
  cat <<HELP
${BOLD}nixcage${NC} v${NIXCAGE_VERSION} -- per-project NixOS containers for AI coding agents

${BOLD}Usage:${NC}
  nixcage [--flake <ref>] <command> [args...]

${BOLD}Commands:${NC}
  enter [--memory <size>] [--cpus <n>] [--bind SRC:DST] [--bind-ro SRC:DST]
        [--setenv K=V] [--shell <name>] [--no-agent] [--print-argv]
        [--substrate nspawn|microvm] [--disk <size>] [-- cmd...]
                     Enter this project's cage (macOS: starts the VM if needed).
                     The substrate is fixed at the cage's first enter; a microVM
                     needs the host's nixcage.microvm.enable, and --disk gives
                     it a persistent image at /var/lib (ADR-019). --memory and
                     --cpus outrank what the host declared for this cage.
                     The options that parameterise a session on behalf of a
                     dependant (--uid, --user, --subject, --home, --network,
                     --dns, --store-root, --no-nix-daemon) are reached with
                     nixcage exec -- nixcage-container enter ...
  exec [--tty] [--agent] -- <cmd...>
                     Run a command as root where the cages are: here on Linux,
                     inside the VM on macOS. This is how a tool built on
                     nixcage reaches nixcage-container.
  list [--json]      What cages this machine has, with what each was given
  rm [name]          Delete a project container and its persistent home
  status             Show container state (macOS: VM state and age public key)
  down               macOS only: stop the VM
  rebuild            macOS only: rebuild the VM from the config flake and restart it
  version            Print version
  help               Show this help

${BOLD}Configuration:${NC}
  Linux: containers run on this host. With nothing declared, the cage is the
  directory you are standing in and the session is built from what this
  nixcage carries; bounds are half this machine. For workspace roots,
  secrets, declared subjects, storage and bridges, import nixcage's
  nixosModules.host in your NixOS configuration and set
  nixcage.workspaceRoots; apply with nixos-rebuild.

  macOS: containers run in a shared VM configured by a flake you own
  (default: ~/.config/nixcage, override with --flake or NIXCAGE_FLAKE):

    nix flake new -t github:hamidr/nixcage ~/.config/nixcage

  A project is any directory under one of your nixcage.workspaceRoots, and
  where nothing is declared, the directory you are in. Its flake.nix and
  devShells.default are both optional: a project with an .envrc is entered
  through direnv, one with neither gets the base container shell. No nixcage
  files exist in projects.
HELP
}

main() {
  if [[ "${1:-}" == "--flake" ]]; then
    if [[ -z "${2:-}" ]]; then
      log_err "--flake requires an argument"
      exit 1
    fi
    NIXCAGE_FLAKE="$2"
    shift 2
  fi

  local command="${1:-help}"
  shift || true
  case "$command" in
  enter)   cmd_enter "$@" ;;
  exec)    cmd_exec "$@" ;;
  down)    cmd_down "$@" ;;
  rebuild) cmd_rebuild "$@" ;;
  list)    cmd_list "$@" ;;
  rm)      cmd_rm "$@" ;;
  status)  cmd_status "$@" ;;
  version | --version | -v) echo "nixcage $NIXCAGE_VERSION" ;;
  help | --help | -h) cmd_help ;;
  *)
    log_err "Unknown command: $command"
    cmd_help
    exit 1
    ;;
  esac
}

# Allow sourcing without executing (for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
